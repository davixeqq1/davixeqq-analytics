# Copy to .env and fill in. NEVER commit .env. Placeholders only — no real values in this file.
# Demo mode (`python -m yt_report demo`) needs none of these settings.
# Relative paths are resolved against the directory containing this .env file.

# --- Google OAuth (Desktop app client downloaded from Google Cloud Console) ---
YT_CLIENT_SECRETS_FILE=credentials.json
YT_TOKEN_FILE=token.json
# Private CI only: full contents of token.json as a secret. Leave empty locally.
# Never use it in a public repository's workflows (Actions logs of public repositories are public).
YT_TOKEN_JSON=

# --- Discord ---
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/REPLACE_ME/REPLACE_ME

# --- Storage & logs ---
DATABASE_PATH=data/yt_report.db
LOG_DIR=logs
LOG_LEVEL=INFO

# --- Reporting ---
# YouTube Analytics data usually lags 2-3 days. The report ends this many days before "today" (Pacific time).
DATA_LAG_DAYS=3
# Last day of the reporting week. The end date (today - DATA_LAG_DAYS) is moved back to the most recent
# such day, so every run - scheduled, retry or manual - reports the same calendar week.
# saturday = Sunday-Saturday weeks (run on Tuesday from 10:00 CET). Weekday name, or "none" for a
# rolling 7-day window. An explicit --end-date is always used as given.
REPORT_WEEK_END=saturday
# Minimum views a video needs in the period to be considered for the "weakest video" check.
MIN_VIEWS_WEAKEST=30
# Minimum eligible videos of the same format needed for a fair retention comparison.
MIN_VIDEOS_PER_FORMAT=3
# Timezone used for "generated at" timestamps in reports.
REPORT_TIMEZONE=Europe/Bratislava

# --- Optional: Claude API recommendations (disabled by default, requires paid API credits) ---
# A Claude Pro/Max subscription does NOT include API credits.
AI_RECOMMENDATIONS=false
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Dashboard ---
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=8050
